# LOCAL DEV ONLY. On EC2 there is no .env file: DB credentials and the JWT
# secret come from AWS Secrets Manager (USE_SECRETS_MANAGER=1) — see
# SECRETS_MANAGER.md. Never copy this file to the EC2 box.
#
# postgres reads these the first time the volume is empty.
POSTGRES_USER=shop
POSTGRES_PASSWORD=shop
POSTGRES_DB=shopping

# inside docker compose the api reaches postgres at host db.
# from your machine (port 5433 in docker-compose) use localhost instead of db.
DATABASE_URL=postgresql+psycopg://shop:shop@db:5432/shopping
# SQLite instead (local run without Docker):
# DATABASE_URL=sqlite+aiosqlite:///./ecommerce.db

# browser origins allowed to call the API (CORS). HTTP ONLY for now.
# comma-separated, exact scheme + host: no path, no trailing slash, no "*".
# "*" and any https:// entry are rejected by app/main.py until HTTPS is deployed.
# set this to the frontend-http bucket website endpoint
# (S3 bucket -> Properties -> Static website hosting -> Bucket website endpoint).
# leave unset locally to allow Vite on 127.0.0.1:5173 / localhost:5173.
CORS_ALLOWED_ORIGINS=http://frontend-http-xy-1234.s3-website-us-east-1.amazonaws.com

# used to sign login tokens.keep this long,hs256 expects 32+ characters.
JWT_SECRET=change-this-shopping-secret-key-32b
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# used only when PAYMENT_API_URL is empty.ok, fail, or timeout.
PAYMENT_FORCE=ok
PAYMENT_MAX_ATTEMPTS=3
PAYMENT_TIMEOUT_SECONDS=2
PAYMENT_RETRY_BASE_DELAY=0.05
# three failed charges move the breaker to half-open. one more turns it off until the fake API mode is ok.
CIRCUIT_MAX_FAILURES=3
CIRCUIT_RESET_SECONDS=30
# inside compose the hostname is provider. from your machine the same port is localhost:9000.
PAYMENT_API_URL=http://provider:9000/payments/charge
# inside compose the hostname is provider. from your machine the same port is localhost:9000.
NOTIFY_API_URL=http://provider:9000/notify
NOTIFY_MAX_ATTEMPTS=3
