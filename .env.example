# postgres reads these the first time the volume is empty.
POSTGRES_USER=shop
POSTGRES_PASSWORD=shop
POSTGRES_DB=shopping

# inside docker compose the api reaches postgres at host db.
# from your machine (port 5433 in docker-compose) use localhost instead of db.
DATABASE_URL=postgresql+psycopg://shop:shop@db:5432/shopping
# SQLite instead (local run without Docker):
# DATABASE_URL=sqlite+aiosqlite:///./ecommerce.db

# used to sign login tokens.keep this long,hs256 expects 32+ characters.
JWT_SECRET=change-this-shopping-secret-key-32b
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# used only when PAYMENT_API_URL is empty.ok, fail, or timeout.
PAYMENT_FORCE=ok
PAYMENT_MAX_ATTEMPTS=3
PAYMENT_TIMEOUT_SECONDS=2
PAYMENT_RETRY_BASE_DELAY=0.05
CIRCUIT_MAX_FAILURES=5
CIRCUIT_RESET_SECONDS=30
# inside compose the hostname is provider. from your machine the same port is localhost:9000.
PAYMENT_API_URL=http://provider:9000/payments/charge
# inside compose the hostname is provider. from your machine the same port is localhost:9000.
NOTIFY_API_URL=http://provider:9000/notify
NOTIFY_MAX_ATTEMPTS=3
